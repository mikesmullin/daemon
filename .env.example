# Meta Muse API — copy this file to .env and fill in your key
#   cp .env.example .env
#   $EDITOR .env
# Never commit .env (see .gitignore)

# Required: API key for the Muse upstream (Meta)
MUSE_API_KEY=your-muse-api-key-here

# Optional: override API base URL (default: https://api.muse.ai)
# For Muse Spark / Meta inference you may use the endpoint assigned to you:
# MUSE_BASE_URL=https://api.muse.ai
# MUSE_BASE_URL=https://muse.meta.ai/api

# Optional: override model (default: muse:muse-1.2-contributor)
# D_MODEL=muse:muse-1.2-contributor
# MUSE_MODEL=muse-1.2-contributor

# Also supported (via --env-file or exported env):
# FAV_LOCAL_LLM / AGL_MODEL are fallbacks if D_MODEL is unset,
# but D_MODEL (or --model flag) takes precedence.
